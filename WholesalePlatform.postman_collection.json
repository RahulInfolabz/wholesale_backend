{
  "info": {
    "name": "Online Wholesale Marketplace and Product Inquiry Platform",
    "description": "Complete API collection for Online Wholesale Marketplace and Product Inquiry Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Common",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/signup",
              "host": ["{{base_url}}"],
              "path": ["signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Vikram Shah\",\n  \"email\": \"vikram@gmail.com\",\n  \"password\": \"Vikram@123\",\n  \"mobile_no\": \"9900000002\",\n  \"address\": \"45, Ring Road, Surat\",\n  \"city\": \"Surat\",\n  \"state\": \"Gujarat\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vikram@gmail.com\",\n  \"password\": \"Vikram@123\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        },
        {
          "name": "Session",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/session",
              "host": ["{{base_url}}"],
              "path": ["session"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/changePassword",
              "host": ["{{base_url}}"],
              "path": ["changePassword"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vikram@gmail.com\",\n  \"newPassword\": \"NewPass@123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🌐 Public",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Get All Brands",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/brands",
              "host": ["{{base_url}}"],
              "path": ["brands"]
            }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Get Products — Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?category_id=CATEGORY_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [{ "key": "category_id", "value": "CATEGORY_ID_HERE" }]
            }
          }
        },
        {
          "name": "Get Products — Filter by Brand",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?brand_id=BRAND_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [{ "key": "brand_id", "value": "BRAND_ID_HERE" }]
            }
          }
        },
        {
          "name": "Get Products — Filter by Price Range",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?min_price=200&max_price=1000",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "min_price", "value": "200" },
                { "key": "max_price", "value": "1000" }
              ]
            }
          }
        },
        {
          "name": "Get Products — Filter by Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?availability_status=In Stock",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [{ "key": "availability_status", "value": "In Stock" }]
            }
          }
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/PRODUCT_ID_HERE",
              "host": ["{{base_url}}"],
              "path": ["products", "PRODUCT_ID_HERE"]
            }
          }
        },
        {
          "name": "Get All Feedbacks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/feedbacks",
              "host": ["{{base_url}}"],
              "path": ["feedbacks"]
            }
          }
        }
      ]
    },
    {
      "name": "🟢 User (Session Required)",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/user/updateProfile",
              "host": ["{{base_url}}"],
              "path": ["user", "updateProfile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Vikram Kumar Shah\",\n  \"mobile_no\": \"9911111111\",\n  \"address\": \"12, New Textile Market, Surat\",\n  \"city\": \"Surat\",\n  \"state\": \"Gujarat\",\n  \"profile_image\": \"https://i.pravatar.cc/150?img=10\"\n}"
            }
          }
        },
        {
          "name": "Add Product Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/user/addProductInquiry",
              "host": ["{{base_url}}"],
              "path": ["user", "addProductInquiry"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"PRODUCT_ID_HERE\",\n  \"inquiry_message\": \"We need 500 units for our retail chain. Can you provide a bulk discount and delivery timeline?\"\n}"
            }
          }
        },
        {
          "name": "My Product Inquiries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/myProductInquiries",
              "host": ["{{base_url}}"],
              "path": ["user", "myProductInquiries"]
            }
          }
        },
        {
          "name": "Add General Inquiry",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/user/addGeneralInquiry",
              "host": ["{{base_url}}"],
              "path": ["user", "addGeneralInquiry"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inquiry_subject\": \"Bulk Order for Mobile Accessories\",\n  \"inquiry_message\": \"Looking for wholesale mobile accessories like covers, screen guards, and cables in bulk quantity.\"\n}"
            }
          }
        },
        {
          "name": "My General Inquiries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/user/myGeneralInquiries",
              "host": ["{{base_url}}"],
              "path": ["user", "myGeneralInquiries"]
            }
          }
        },
        {
          "name": "Add Feedback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/user/addFeedback",
              "host": ["{{base_url}}"],
              "path": ["user", "addFeedback"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feedback_message\": \"Excellent wholesale platform. Product specs and pricing are very transparent.\",\n  \"rating\": 5\n}"
            }
          }
        }
      ]
    }
  ]
}
